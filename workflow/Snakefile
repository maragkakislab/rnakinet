        expand('outputs/visual/predictions/{model_name}/{group}_{reference_level}_level_auroc_{plot_type}.pdf',
            model_name=LEGACY_SU4_MODELS, group=SU4_GROUPS + SU4_GROUPS_FULL,
            reference_level=['gene', 'transcript'], plot_type=['histogram', 'scatter']),

        # ── Plain inference: pct_pos + preds.csv ───────────────────────────
        # 5EU models → 5EU experiments
        expand('outputs/predictions_pct_pos/{model_name}/{experiment_name}_percent_positive.txt',
            model_name=EU5_MODELS + ['batch_64_multispecies_2'],
            experiment_name=EU5_BASE_EXPERIMENTS),
        expand('outputs/predictions/{model_name}/{experiment_name}/preds.csv',
            model_name=EU5_MODELS + ['batch_64_multispecies_2'],
            experiment_name=EU5_BASE_EXPERIMENTS),
        # 4SU models → 4SU experiments
        expand('outputs/predictions_pct_pos/{model_name}/{experiment_name}_percent_positive.txt',
            model_name=SU4_MODELS + LEGACY_SU4_MODELS,
            experiment_name=SU4_BASE_EXPERIMENTS),
        expand('outputs/predictions/{model_name}/{experiment_name}/preds.csv',
            model_name=SU4_MODELS + LEGACY_SU4_MODELS,
            experiment_name=SU4_BASE_EXPERIMENTS),
        # Mega model → both
        expand('outputs/predictions_pct_pos/{model_name}/{experiment_name}_percent_positive.txt',
            model_name=['R10_mega_model_1'],
            experiment_name=EU5_BASE_EXPERIMENTS + SU4_BASE_EXPERIMENTS),
        expand('outputs/predictions/{model_name}/{experiment_name}/preds.csv',
            model_name=['R10_mega_model_1'],
            experiment_name=EU5_BASE_EXPERIMENTS + SU4_BASE_EXPERIMENTS),